\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Fock-space dimension scaling of HPT-QRC. Row (a): vary $n$, fix $m=8$. Row (b): vary $m$, fix $n=3$. Mackey--Glass shows the cleanest monotone Fock-dim trend; NARMA-10 is sample-limited. Numerical values in \texttt  {results/ablation\_fock\_scaling\_\{photon,mode\}.csv}.}}{7}{figure.1}\protected@file@percent }
\newlabel{fig:fock}{{1}{7}{Fock-space dimension scaling of HPT-QRC. Row (a): vary $n$, fix $m=8$. Row (b): vary $m$, fix $n=3$. Mackey--Glass shows the cleanest monotone Fock-dim trend; NARMA-10 is sample-limited. Numerical values in \texttt {results/ablation\_fock\_scaling\_\{photon,mode\}.csv}}{figure.1}{}}
\citation{maring2024ascella}
\@writefile{lot}{\contentsline {table}{\numberline {7}{\ignorespaces Linear MC and IPC. Feature dim $\approx 95$ for both HPT-QRC rows: $R\cdot V\cdot \texttt  {lex\_out} + W = 3\cdot 3\cdot 10 + 5 = 95$ (three reservoirs, virtual depth $3$, lex-out $10$, raw-window context dim $5$). The homogeneous and heterogeneous photon ensembles both use $R=3$ reservoirs with the same downstream \texttt  {LexGrouping}$\to $$10$ output and so produce the same total feature dimension; the heterogeneous ensemble differs in which photon-number Fock spaces are sampled. ESN res-$200$ row is the matched-dim comparator; ESN-$1000$ is a larger-capacity reference. HPT-QRC dominates Random-Linear; at matched dim, ESN holds higher linear-MC and IPC$_{\mathrm  {deg}\!\leq \!2}$, while HPT-QRC has the largest degree-3 IPC ($32.6$ vs ESN-200's $24.6$).}}{8}{table.7}\protected@file@percent }
\newlabel{tab:ipc}{{7}{8}{Linear MC and IPC. Feature dim $\approx 95$ for both HPT-QRC rows: $R\cdot V\cdot \texttt {lex\_out} + W = 3\cdot 3\cdot 10 + 5 = 95$ (three reservoirs, virtual depth $3$, lex-out $10$, raw-window context dim $5$). The homogeneous and heterogeneous photon ensembles both use $R=3$ reservoirs with the same downstream \texttt {LexGrouping}$\to $$10$ output and so produce the same total feature dimension; the heterogeneous ensemble differs in which photon-number Fock spaces are sampled. ESN res-$200$ row is the matched-dim comparator; ESN-$1000$ is a larger-capacity reference. HPT-QRC dominates Random-Linear; at matched dim, ESN holds higher linear-MC and IPC$_{\mathrm {deg}\!\leq \!2}$, while HPT-QRC has the largest degree-3 IPC ($32.6$ vs ESN-200's $24.6$)}{table.7}{}}
